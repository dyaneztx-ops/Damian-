# Copy this file to .env.local (for local dev) and add the same keys in Vercel → Project → Settings → Environment Variables.

# Your live site URL (used for sitemap, canonical URLs, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---- Form email delivery (pick ONE) ----
# Option A: Resend (recommended). Get a key at https://resend.com
RESEND_API_KEY=
# "From" address must be on a domain you verified in Resend. Until then use onboarding@resend.dev
RESEND_FROM=Website Leads <onboarding@resend.dev>
# Where leads are delivered (defaults to the email in src/config/site.ts)
LEAD_TO_EMAIL=

# Option B: Formspree. Create a form at https://formspree.io and paste its endpoint
FORMSPREE_ENDPOINT=

# ---- Analytics (leave blank to keep them OFF) ----
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
